@model IEnumerable<OnTrack.Models.Trip>

@{
    ViewData["Title"] = "Trips";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Trips</h1>
            <p class="text-muted">
                @(User.IsInRole("Admin") ? "Manage all trips in the system." : "Browse available trips and book your ticket.")
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-area="Admin"
               asp-controller="Trips"
               asp-action="Create"
               class="btn btn-primary">
                Create Trip
            </a>
        }
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Route Name</th>
                <th>Train</th>
                <th>Trip Date</th>
                <th>Status</th>
                <th>Price</th
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var trip in Model)
            {
                <tr>
                    <td>@trip.RouteName</td>
                    <td>@trip.Train?.TrainNumber</td>
                    <td>@trip.TripDate.ToString("g")</td>
                    <td>@trip.Status</td>
                    <td>@trip.Price.ToString("C")</td>

                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-area="Admin"
                               asp-controller="Trip"
                               asp-action="Details"
                               asp-route-id="@trip.TripId"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Trip"
                               asp-action="Edit"
                               asp-route-id="@trip.TripId"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Trip"
                               asp-action="Delete"
                               asp-route-id="@trip.TripId"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        }
                        else
                        {
                            <a asp-area="Admin"
                               asp-controller="Trips"
                               asp-action="Book"
                               asp-route-id="@trip.TripId"
                               class="btn btn-sm btn-primary">
                                Book a Trip
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>