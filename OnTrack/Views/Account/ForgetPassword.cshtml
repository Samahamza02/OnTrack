@model OnTrack.ViewModels.ForgetPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container">
    <div class="auth-card shadow-sm p-4 p-md-5">
        <h2 class="h4 mb-4 text-center">Forgot Your Password?</h2>
        <p class="text-muted text-center mb-4">Enter your email and we'll send you a link to reset it.</p>

        <form asp-action="ForgetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            <a asp-action="Login">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
