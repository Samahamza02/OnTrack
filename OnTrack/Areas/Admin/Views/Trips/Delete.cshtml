@model OnTrack.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<div class="container mt-4">

    <h1>Delete Trip</h1>
    <p class="text-danger">Are you sure you want to delete this trip?</p>

    <dl class="row">
        <dt class="col-sm-3">Route Name</dt>
        <dd class="col-sm-9">@Model.RouteName</dd>

        <dt class="col-sm-3">Train</dt>
        <dd class="col-sm-9">@Model.Train?.TrainNumber</dd>

        <dt class="col-sm-3">Trip Date</dt>
        <dd class="col-sm-9">@Model.TripDate.ToString("g")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-area="Admin" asp-controller="Trips" asp-action="Delete" method="post">
        <input type="hidden" asp-for="TripId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-area="Admin" asp-controller="Trips" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>