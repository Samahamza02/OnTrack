@{ ViewData["Title"] = "Check your email"; }
<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />
<section class="auth-shell auth-shell-status"><aside class="auth-showcase"><a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">OT</span><span>OnTrack</span></a><div class="showcase-copy"><span class="eyebrow">MESSAGE DISPATCHED</span><h1>Check your<br /><em>inbox.</em></h1><p>Keep an eye out for our message. Your next journey is one step closer.</p></div><div class="rail-illustration" aria-hidden="true"><div class="sun"></div><div class="rail-horizon"></div><div class="rail-line rail-one"></div><div class="rail-line rail-two"></div><div class="mini-train"><span></span><span></span><span></span></div></div><div class="showcase-footer"><span class="live-dot"></span> Almost there</div></aside><div class="auth-content status-content"><div class="status-symbol status-info">✉</div><span class="eyebrow">PLEASE CHECK YOUR EMAIL</span><h2>Look for our message</h2><p class="status-description">If an account with that email exists and still needs confirmation, we'll send a new confirmation link. Check your spam folder too.</p><a asp-action="Login" class="auth-submit auth-link-button">Back to sign in <span>→</span></a><div class="auth-switch"><a asp-action="ResendEmailConfirmation">Try another email address</a></div></div></section>
