@model OnTrack.Models.Trip

@{
    ViewData["Title"] = "Edit Trip";
}

<div class="container mt-4">

    <h1>Edit Trip</h1>

    <form asp-area="Admin" asp-controller="Trips" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="TripId" />

        <div class="mb-3">
            <label asp-for="RouteName" class="form-label"></label>
            <input asp-for="RouteName" class="form-control" />
            <span asp-validation-for="RouteName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TripDate" class="form-label"></label>
            <input asp-for="TripDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="TripDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Scheduled">Scheduled</option>
                <option value="OnTime">OnTime</option>
                <option value="Delayed">Delayed</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TrainId" class="form-label"></label>
            <select asp-for="TrainId" class="form-select" asp-items="ViewBag.TrainId">
            </select>
            <span asp-validation-for="TrainId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Admin" asp-controller="Trips" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>

</div>