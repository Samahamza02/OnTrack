@model OnTrack.Models.Trip

@{
    ViewData["Title"] = "Trip Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Trip Details</h1>
        <a asp-area="Admin" asp-controller="Trips" asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Route Name</dt>
        <dd class="col-sm-9">@Model.RouteName</dd>

        <dt class="col-sm-3">Train</dt>
        <dd class="col-sm-9">@Model.Train?.TrainNumber - @Model.Train?.TrainName</dd>

        <dt class="col-sm-3">Trip Date</dt>
        <dd class="col-sm-9">@Model.TripDate.ToString("g")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <a asp-area="Admin" asp-controller="Trips" asp-action="Edit" asp-route-id="@Model.TripId" class="btn btn-warning">
        Edit
    </a>

</div>