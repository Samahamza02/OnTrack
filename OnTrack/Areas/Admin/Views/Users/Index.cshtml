@model List<UserListVm>
@{ ViewData["Title"] = "Users"; }

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Users</h2>
  <a asp-action="Create" class="btn btn-primary">Create user</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="mb-3 d-flex gap-2">
  <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email" />
  <button class="btn btn-outline-secondary">Search</button>
</form>

<table class="table table-striped align-middle">
  <thead>
    <tr><th>Full name</th><th>Email</th><th>Phone</th><th>Roles</th><th>Status</th><th></th></tr>
  </thead>
  <tbody>
  @foreach (var u in Model)
  {
    <tr>
      <td>@u.FullName</td>
      <td>@u.Email</td>
      <td>@u.PhoneNumber</td>
      <td>@string.Join(", ", u.Roles)</td>
      <td>
        @if (u.IsLocked) { <span class="badge bg-danger">Locked</span> }
        else { <span class="badge bg-success">Active</span> }
      </td>
      <td class="text-end">
        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">Edit</a>
        <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="d-inline">
          <button class="btn btn-sm @(u.IsLocked ? "btn-success" : "btn-danger")">
            @(u.IsLocked ? "Unlock" : "Lock")
          </button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>