@model OnTrack.Models.Notification

@{
    ViewData["Title"] = "Create Notification";
}

<style>
    .nf-page {
        background: #f2f6f5;
        padding: 35px;
        min-height: 75vh;
        border-radius: 18px;
    }

        .nf-page h1 {
            color: #102f3b;
            font-size: 32px;
            font-weight: 800;
        }

    .nf-card {
        max-width: 800px;
        background: white;
        border: 1px solid #e3ebe9;
        border-radius: 20px;
        padding: 30px;
        margin-top: 25px;
        box-shadow: 0 8px 28px #102f3b0c;
    }

    .nf-label {
        display: block;
        color: #102f3b;
        font-weight: 700;
        margin: 17px 0 8px;
    }

    .nf-input {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 13px 14px;
        border: 1px solid #dce6e4;
        border-radius: 10px;
        background: #f8fbfa;
        color: #102f3b;
    }

        .nf-input:focus {
            outline: 2px solid #43d6be;
            border-color: #43d6be;
        }

    .nf-btn {
        display: inline-block;
        margin: 20px 7px 0 0;
        padding: 11px 16px;
        border: 0;
        border-radius: 9px;
        background: #102f3b;
        color: white !important;
        text-decoration: none;
        font-weight: 700;
        cursor: pointer;
    }

        .nf-btn:hover {
            background: #43d6be;
            color: #102f3b !important;
        }

    .nf-error {
        color: #c94c4c;
    }
</style>

<div class="nf-page">
    <h1>Create Notification</h1>
    <p style="color:#788990">Send an update to a selected user.</p>

    <div class="nf-card">
        <form asp-area="Admin" asp-controller="Notifications" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="nf-error"></div>

            <label class="nf-label" asp-for="Message">Message</label>
            <textarea asp-for="Message" class="nf-input" rows="4" required></textarea>
            <span asp-validation-for="Message" class="nf-error"></span>

            <label class="nf-label" asp-for="UserId">Recipient</label>
            <select asp-for="UserId" asp-items="ViewBag.Users" class="nf-input" required>
                <option value="">-- Select user --</option>
            </select>
            <span asp-validation-for="UserId" class="nf-error"></span>

            <label class="nf-label" asp-for="TripId">Related Trip (optional)</label>
            <select asp-for="TripId" asp-items="ViewBag.Trips" class="nf-input">
                <option value="">-- No specific trip --</option>
            </select>

            <button type="submit" class="nf-btn">Create Notification</button>
            <a class="nf-btn" style="background:#edf0f2;color:#102f3b!important" asp-area="Admin" asp-controller="Notifications" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
