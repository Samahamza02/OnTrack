@model OnTrack.ViewModels.ResetPasswordVM
@{ ViewData["Title"] = "Reset password"; }
<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />
<section class="auth-shell auth-shell-status"><aside class="auth-showcase"><a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">OT</span><span>OnTrack</span></a><div class="showcase-copy"><span class="eyebrow">SECURE YOUR ACCOUNT</span><h1>A new key<br />for your <em>journey.</em></h1><p>Choose a new password to protect your OnTrack account.</p></div><div class="rail-illustration" aria-hidden="true"><div class="sun"></div><div class="rail-horizon"></div><div class="rail-line rail-one"></div><div class="rail-line rail-two"></div><div class="mini-train"><span></span><span></span><span></span></div></div><div class="showcase-footer"><span class="live-dot"></span> Secure access, every time</div></aside><div class="auth-content"><div class="auth-mobile-brand"><span class="brand-mark">OT</span><span>OnTrack</span></div><div class="auth-heading"><span class="eyebrow">PASSWORD RESET</span><h2>Choose a new password</h2><p>Make it strong and easy for you to remember.</p></div><form asp-action="ResetPassword" method="post" class="auth-form"><input type="hidden" asp-for="Email" /><input type="hidden" asp-for="Token" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field-group"><label asp-for="Password">New password</label><input asp-for="Password" class="form-control auth-input" placeholder="Enter a new password" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span></div><div class="field-group"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" class="form-control auth-input" placeholder="Enter it again" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div><button type="submit" class="auth-submit">Save new password <span>→</span></button></form><div class="auth-switch"><a asp-action="Login">← Back to sign in</a></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
