@model IEnumerable<OnTrack.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<style>
    .payments-page {
        background: #f2f5f6;
        min-height: 100vh;
        padding: 30px;
        color: #173440;
        font-family: Arial, sans-serif;
    }

    .payments-header {
        background: linear-gradient(135deg, #10313d, #174b56);
        color: white;
        padding: 30px;
        border-radius: 18px;
        margin-bottom: 25px;
    }

    .payments-brand {
        color: #43d3be;
        font-weight: bold;
        letter-spacing: 2px;
        font-size: 13px;
    }

    .payments-header h1 {
        margin-top: 18px;
        font-weight: bold;
        font-size: 32px;
    }

    .payments-header p {
        color: #d0dee2;
        margin-bottom: 0;
    }

    .payments-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(16, 49, 61, 0.06);
    }

    .payments-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .payments-table th {
        background: #edf4f5;
        color: #31515b;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 15px 12px;
        text-align: left;
        white-space: nowrap;
    }

    .payments-table td {
        padding: 16px 12px;
        border-bottom: 1px solid #edf0f1;
        color: #425761;
        font-size: 14px;
    }

    .payments-table tbody tr:hover {
        background: #f7fbfb;
    }

    .payment-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #e4f7f3;
        color: #168777;
        font-size: 12px;
        font-weight: bold;
    }

    .payment-details {
        color: #138f83;
        text-decoration: none;
        font-weight: bold;
    }

    .payment-details:hover {
        color: #10313d;
    }

    .payments-count {
        color: #71828a;
        font-size: 14px;
    }

    .payments-table-wrapper {
        overflow-x: auto;
    }

    .payments-empty {
        text-align: center;
        padding: 35px;
        color: #71828a;
    }

    @@media (max-width: 768px) {
        .payments-page {
            padding: 15px;
        }

        .payments-header {
            padding: 22px;
        }

        .payments-header h1 {
            font-size: 26px;
        }

        .payments-card {
            padding: 15px;
        }
    }
</style>

<div class="payments-page">

    <div class="payments-header">
        <div class="payments-brand">ONTRACK · TRAIN TRIPS TRACKING</div>

        <h1>Payments</h1>

        <p>Manage and review train ticket payment records.</p>
    </div>

    <div class="payments-card">
        
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}


        <h4>Payment Records</h4>

        <p class="payments-count">
            Review the payment transactions recorded in the system.
        </p>

        <div class="payments-table-wrapper">
            <table class="payments-table">
                <thead>
                    <tr>
                        <th>Payment ID</th>
                        <th>Ticket ID</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Paid At</th>
                        <th>Details</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var payment in Model)
                        {
                            <tr>
                                <td>#@payment.PaymentId</td>
                                <td>#@payment.TicketId</td>
                                <td>@payment.Amount.ToString("N2")</td>
                                <td>@payment.PaymentMethod</td>
                                <td>
                                    <span class="payment-status">
                                        @payment.Status
                                    </span>
                                </td>
                                <td>@payment.PaidAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-controller="Payments"
                                       asp-action="Details"
                                       asp-route-id="@payment.PaymentId"
                                       class="payment-details">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="payments-empty">
                                No payment records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>