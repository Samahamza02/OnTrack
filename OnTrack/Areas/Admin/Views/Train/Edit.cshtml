
@model OnTrack.Models.Train

@{
    ViewData["Title"] = "Edit Train";
}

<div class="container mt-4">
    <h1>Edit Train</h1>
    <p class="text-muted">Update train information.</p>

    <form asp-area="Admin"
          asp-controller="Train"
          asp-action="Edit"
          asp-route-id="@Model.TrainId"
          method="post">

        <input type="hidden" asp-for="TrainId" />

  <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="TrainNumber" class="form-label">
                Train Number
            </label>

            <input asp-for="TrainNumber" class="form-control" />

            <span asp-validation-for="TrainNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TrainName" class="form-label">
                Name
            </label>

            <input asp-for="TrainName" class="form-control" />

            <span asp-validation-for="TrainName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Capacity" class="form-label">
                Capacity
            </label>

            <input asp-for="Capacity" class="form-control" type="number" />

            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TrainType" class="form-label">
                Type
            </label>

            <input asp-for="TrainType" class="form-control" />

            <span asp-validation-for="TrainType" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-area="Admin"
           asp-controller="Train"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Trains
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
