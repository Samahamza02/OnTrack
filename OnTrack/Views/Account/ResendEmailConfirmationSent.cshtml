@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container">
    <div class="auth-card shadow-sm p-4 p-md-5 text-center">
        <i class="bi bi-envelope-check-fill text-primary" style="font-size: 3rem;"></i>
        <h2 class="h4 mt-3">Check Your Email</h2>
        <p class="text-muted">If an account with that email exists and isn't confirmed yet, we've sent a new confirmation link.</p>
        <a asp-action="Login" class="btn btn-primary mt-2">Back to Login</a>
    </div>
</div>
