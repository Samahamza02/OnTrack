@model IEnumerable<OnTrack.Models.Evaluation>

@{
    ViewData["Title"] = "My Evaluations";
}

<style>
    .evaluation-page {
        background: #0b292b;
        color: #e8f3f1;
        min-height: 100vh;
        padding: 35px 20px 70px;
        font-family: Arial, sans-serif;
    }

    .evaluation-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .eyebrow {
        color: #71dfc2;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .page-title {
        color: #f0f7f5 !important;
        font-family: Georgia, serif;
        font-size: 46px;
        margin: 8px 0 5px;
    }

        .page-title span {
            color: #71dfc2 !important;
            font-style: italic;
        }

    .page-description {
        color: #a7c1bb !important;
        margin-bottom: 25px;
        font-size: 15px;
    }

    /* Statistics */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: #113b3d;
        border: 1px solid #1c5553;
        border-radius: 17px;
        padding: 20px 22px;
    }

    .stat-label {
        color: #a7c1bb !important;
        font-size: 14px;
    }

    .stat-number {
        color: #71dfc2 !important;
        font-size: 36px;
        font-weight: bold;
        margin-top: 5px;
    }

        .stat-number small {
            font-size: 15px;
            color: #a7c1bb !important;
            font-weight: normal;
        }

    /* Filters */

    .filters {
        display: flex;
        align-items: end;
        gap: 15px;
        margin: 25px 0;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filter-group label {
            color: #a7c1bb !important;
            font-size: 13px;
        }

    .filter-control {
        background: #113b3d !important;
        color: #e8f3f1 !important;
        border: 1px solid #28615e !important;
        border-radius: 11px;
        padding: 11px 14px;
        min-width: 170px;
        outline: none;
    }

        .filter-control option {
            background: #113b3d;
            color: #ffffff;
        }

    .btn-reset {
        color: #71dfc2 !important;
        text-decoration: none;
        padding: 11px 5px;
        font-size: 14px;
        background: none;
        border: none;
        cursor: pointer;
    }

        .btn-reset:hover {
            color: #ffffff !important;
        }

    /* Evaluation Cards */

    .evaluation-card {
        background: #113b3d;
        border: 1px solid #1c5553;
        border-radius: 17px;
        padding: 22px 24px;
        margin-bottom: 15px;
        color: #e8f3f1 !important;
    }

    .evaluation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .trip-title {
        color: #e8f3f1 !important;
        font-size: 19px;
        font-weight: bold;
        margin: 0;
    }

    .trip-id {
        color: #a7c1bb !important;
        font-size: 13px;
        font-weight: normal;
    }

    .trip-date {
        color: #a7c1bb !important;
        font-size: 14px;
        margin-top: 5px;
    }

    .status-badge {
        border: 1px solid #28615e;
        border-radius: 20px;
        color: #71dfc2 !important;
        padding: 4px 13px;
        font-size: 12px;
        white-space: nowrap;
    }

    /* Stars */

    .stars {
        margin: 17px 0 10px;
        font-size: 22px;
        letter-spacing: 2px;
    }

    .star-filled {
        color: #71dfc2 !important;
    }

    .star-empty {
        color: #426b68 !important;
    }

    /* Comment */

    .evaluation-comment {
        color: #f0f7f5 !important;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 12px;
        font-weight: 400;
    }

    .review-date {
        color: #a7c1bb !important;
        font-size: 13px;
    }

    /* Empty State */

    .empty-state {
        background: #113b3d;
        border: 1px solid #1c5553;
        border-radius: 17px;
        padding: 40px 20px;
        text-align: center;
        color: #a7c1bb !important;
    }

        .empty-state h3 {
            color: #71dfc2 !important;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #a7c1bb !important;
        }

    /* Responsive */

    @@media (max-width: 650px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 35px;
        }

        .evaluation-header {
            align-items: flex-start;
        }

        .filters {
            align-items: stretch;
        }

        .filter-group,
        .filter-control {
            width: 100%;
        }
    }
</style>

<div class="evaluation-page">

    <div class="evaluation-container">

        <!-- Header -->

        <div class="eyebrow">Customer</div>

        <h1 class="page-title">
            My <span>Evaluations</span>
        </h1>

        <p class="page-description">
            Your feedback and ratings for every trip you've taken.
        </p>

        <!-- Statistics -->

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-label">Total reviews</div>
                <div class="stat-number">
                    @ViewBag.TotalReviews
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Average rating</div>
                <div class="stat-number">
                    @(((double)ViewBag.AverageRating).ToString("0.0"))
                    <small>/ 5</small>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">5-star trips</div>
                <div class="stat-number">
                    @ViewBag.FiveStarTrips
                </div>
            </div>

        </div>

        <!-- Filters -->

        <form method="get"
              asp-area="Customer"
              asp-controller="Evaluations"
              asp-action="Index"
              class="filters">

            <div class="filter-group">

                <label for="sortBy">Sort by</label>

                <select name="sortBy"
                        id="sortBy"
                        class="filter-control">

                    <option value="newest"
                            selected="@(ViewBag.SortBy == "newest")">
                        Newest first
                    </option>

                    <option value="oldest"
                            selected="@(ViewBag.SortBy == "oldest")">
                        Oldest first
                    </option>

                    <option value="highest"
                            selected="@(ViewBag.SortBy == "highest")">
                        Highest rating
                    </option>

                    <option value="lowest"
                            selected="@(ViewBag.SortBy == "lowest")">
                        Lowest rating
                    </option>

                </select>

            </div>

            <div class="filter-group">

                <label for="stars">Stars</label>

                <select name="stars"
                        id="stars"
                        class="filter-control">

                    <option value=""
                            selected="@(ViewBag.Stars == null)">
                        All
                    </option>

                    @for (int i = 5; i >= 1; i--)
                    {
                        <option value="@i"
                                selected="@(ViewBag.Stars != null &&
                                                                (int)ViewBag.Stars == i)">
                    @i Stars
                </option>
            }

        </select>

    </div>

    <button type="submit" class="btn-reset">
        Apply filters
    </button>

    <a asp-area="Customer"
       asp-controller="Evaluations"
       asp-action="Index"
       class="btn-reset">
        Reset
    </a>

</form>

<!-- Evaluations -->
@if (Model != null && Model.Any())
{
    @foreach (var evaluation in Model)
    {
        <div class="evaluation-card">

            <div class="evaluation-header">

                <div>

                    <h3 class="trip-title">
                        Ticket #@evaluation.TicketId

                        <span class="trip-id">
                            Evaluation #@evaluation.EvaluationId
                        </span>
                    </h3>

                    <div class="trip-date">
                        Booked on
                        @evaluation.Ticket.BookingDate.ToString("dd MMM yyyy")
                    </div>

                </div>

                <span class="status-badge">
                    @evaluation.Ticket.Status
                </span>

            </div>

            <!-- Rating Stars -->

            <div class="stars">

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= evaluation.rating)
                    {
                        <span class="star-filled">★</span>
                    }
                    else
                    {
                        <span class="star-empty">★</span>
                    }
                }

            </div>

            <!-- Customer Comment -->

            <p class="evaluation-comment">
                @evaluation.comment
            </p>

            <!-- Review Date -->

            <div class="review-date">
                Reviewed on
                @evaluation.CreatedAt.ToString("dd MMM yyyy, HH:mm")
            </div>

        </div>
    }
}
else
{
    <div class="empty-state">

        <h3>No evaluations yet</h3>

        <p>
            You haven't submitted any trip reviews yet.
            Your evaluations will appear here.
        </p>

    </div>
}

</div>

</div>
