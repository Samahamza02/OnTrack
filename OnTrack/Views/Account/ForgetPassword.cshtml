@model OnTrack.ViewModels.ForgetPasswordVM
@{ ViewData["Title"] = "Forgot password"; }
<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />
<section class="auth-shell auth-shell-status"><aside class="auth-showcase"><a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">OT</span><span>OnTrack</span></a><div class="showcase-copy"><span class="eyebrow">NO WORRIES</span><h1>Every route<br />has a <em>way back.</em></h1><p>It happens. We'll help you get back on track with a secure password reset link.</p></div><div class="rail-illustration" aria-hidden="true"><div class="sun"></div><div class="rail-horizon"></div><div class="rail-line rail-one"></div><div class="rail-line rail-two"></div><div class="mini-train"><span></span><span></span><span></span></div></div><div class="showcase-footer"><span class="live-dot"></span> We'll help you get moving again</div></aside>
<div class="auth-content"><div class="auth-mobile-brand"><span class="brand-mark">OT</span><span>OnTrack</span></div><div class="auth-heading"><span class="eyebrow">ACCOUNT RECOVERY</span><h2>Forgot your password?</h2><p>Enter the email linked to your account. We'll send you a reset link.</p></div><form asp-action="ForgetPassword" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field-group"><label asp-for="Email">Email address</label><input asp-for="Email" class="form-control auth-input" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><button type="submit" class="auth-submit">Send reset link <span>→</span></button></form><div class="auth-switch"><a asp-action="Login">← Back to sign in</a></div><div class="auth-security"><span>▣</span> Reset links are sent securely.</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
