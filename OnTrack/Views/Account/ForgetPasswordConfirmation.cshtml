@{ ViewData["Title"] = "Check your email"; }
<link rel="stylesheet"
      href="~/css/auth.css"
      asp-append-version="true" />
<section class="auth-shell auth-shell-status"><aside class="auth-showcase"><a class="auth-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">OT</span><span>OnTrack</span></a><div class="showcase-copy"><span class="eyebrow">A FRESH START</span><h1>Back on track<br /><em>in no time.</em></h1><p>We're helping you securely get back into your account.</p></div><div class="rail-illustration" aria-hidden="true"><div class="sun"></div><div class="rail-horizon"></div><div class="rail-line rail-one"></div><div class="rail-line rail-two"></div><div class="mini-train"><span></span><span></span><span></span></div></div><div class="showcase-footer"><span class="live-dot"></span> Your journey continues</div></aside><div class="auth-content status-content"><div class="status-symbol status-info">✉</div><span class="eyebrow">EMAIL SENT</span><h2>Check your inbox</h2><p class="status-description">If an account with that email exists, we've sent a password reset link. Follow the instructions in the email to choose a new password.</p><a asp-action="Login" class="auth-submit auth-link-button">Back to sign in <span>→</span></a><div class="auth-security"><span>▣</span> For your security, the link may expire.</div></div></section>
