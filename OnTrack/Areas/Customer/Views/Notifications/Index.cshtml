@model IEnumerable<OnTrack.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">

    <!-- Header -->
    <div class="hero-section mb-4">
        <div>
            <span class="hero-label">ONTRACK RAILWAYS</span>

            <h1>Notifications</h1>

            <p>
                Stay updated with your trips, tickets, and important travel information.
            </p>
        </div>
    </div>

    <!-- Notifications Card -->
    <div class="notifications-card">

        <div class="notifications-header">

            <div>
                <h2>Your Notifications</h2>
                <p>
                    View your latest updates and important messages.
                </p>
            </div>

            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllAsRead" method="post">
                    <button type="submit" class="mark-all-btn">
                        Mark All as Read
                    </button>
                </form>
            }

        </div>

        <div class="notifications-list">

            @if (!Model.Any())
            {
                <div class="empty-notifications">

                    <div class="empty-icon">
                        <span>!</span>
                    </div>

                    <h3>No notifications yet</h3>

                    <p>
                        You don't have any notifications at the moment.
                        We'll let you know when something important happens.
                    </p>

                </div>
            }
            else
            {
                @foreach (var notification in Model)
                {
                    <div class="notification-item @(notification.IsRead ? "read" : "unread")">

                        <div class="notification-icon">
                            <span>!</span>
                        </div>

                        <div class="notification-content">

                            <div class="notification-top">

                                <h3>
                                    @if (notification.IsRead)
                                    {
                                        @:Notification
                                    }
                                    else
                                    {
                                        @:New Notification
                                    }
                                </h3>

                                @if (!notification.IsRead)
                                {
                                    <span class="unread-badge">
                                        New
                                    </span>
                                }

                            </div>

                            <p>
                                @notification.Message
                            </p>

                            <span class="notification-date">
                                @notification.SentAt.ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                        </div>

                        @if (!notification.IsRead)
                        {
                            <div class="notification-action">

                                <form asp-action="MarkAsRead"
                                      asp-route-id="@notification.NotificationId"
                                      method="post">

                                    <button type="submit" class="read-btn">
                                        Mark as Read
                                    </button>

                                </form>

                            </div>
                        }

                    </div>
                }
            }

        </div>

    </div>

</div>

<style>

    body {
        background-color: #f4f7f8;
    }

    .container {
        max-width: 1030px;
    }

    /* Hero */

    .hero-section {
        background: #142c3c;
        border-radius: 18px;
        padding: 34px 38px;
        color: white;
    }

    .hero-label {
        color: #42d6bd;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .hero-section h1 {
        margin: 8px 0 8px;
        font-size: 34px;
        font-weight: 700;
    }

    .hero-section p {
        margin: 0;
        color: #e3eaed;
        font-size: 15px;
    }

    /* Main Card */

    .notifications-card {
        background: #ffffff;
        border: 1px solid #e0e7ea;
        border-radius: 18px;
        overflow: hidden;
    }

    .notifications-header {
        padding: 25px 28px;
        border-bottom: 1px solid #e5eaed;

        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .notifications-header h2 {
        margin: 0 0 5px;
        color: #142c3c;
        font-size: 22px;
        font-weight: 700;
    }

    .notifications-header p {
        margin: 0;
        color: #71808a;
        font-size: 14px;
    }

    /* Mark All */

    .mark-all-btn {
        border: 1px solid #42d6bd;
        background: #ffffff;
        color: #0c796f;

        padding: 10px 16px;
        border-radius: 8px;

        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
        transition: 0.2s;
    }

    .mark-all-btn:hover {
        background: #42d6bd;
        color: #ffffff;
    }

    /* Notifications List */

    .notifications-list {
        padding: 0;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 18px;

        padding: 23px 28px;

        border-bottom: 1px solid #e8edef;

        transition: background-color 0.2s;
    }

    .notification-item:last-child {
        border-bottom: none;
    }

    .notification-item:hover {
        background-color: #fafcfc;
    }

    /* Unread */

    .notification-item.unread {
        background-color: #f1fbf9;
    }

    .notification-item.unread:hover {
        background-color: #eaf8f5;
    }

    /* Icon */

    .notification-icon {
        width: 44px;
        height: 44px;

        min-width: 44px;

        border-radius: 50%;

        background: #e7f8f5;
        color: #0c796f;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 18px;
        font-weight: 700;
    }

    .notification-item.read .notification-icon {
        background: #edf1f3;
        color: #71808a;
    }

    /* Content */

    .notification-content {
        flex: 1;
        min-width: 0;
    }

    .notification-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 5px;
    }

    .notification-top h3 {
        margin: 0;
        color: #142c3c;
        font-size: 16px;
        font-weight: 700;
    }

    .notification-item.read .notification-top h3 {
        font-weight: 600;
    }

    .notification-content p {
        margin: 0 0 7px;
        color: #4f606a;
        font-size: 14px;
        line-height: 1.6;
    }

    .notification-date {
        color: #89969d;
        font-size: 12px;
    }

    /* New Badge */

    .unread-badge {
        background: #42d6bd;
        color: #ffffff;

        padding: 3px 8px;
        border-radius: 20px;

        font-size: 10px;
        font-weight: 700;
    }

    /* Action */

    .notification-action {
        display: flex;
        align-items: center;
    }

    .read-btn {
        border: none;
        background: transparent;
        color: #0c796f;

        font-size: 12px;
        font-weight: 600;

        cursor: pointer;
        white-space: nowrap;

        padding: 8px 0;
    }

    .read-btn:hover {
        text-decoration: underline;
    }

    /* Empty */

    .empty-notifications {
        text-align: center;
        padding: 70px 30px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;

        margin: 0 auto 18px;

        border-radius: 50%;

        background: #edf1f3;
        color: #71808a;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-icon span {
        font-size: 24px;
        font-weight: 700;
    }

    .empty-notifications h3 {
        margin: 0 0 8px;

        color: #142c3c;
        font-size: 20px;
    }

    .empty-notifications p {
        max-width: 500px;
        margin: 0 auto;

        color: #71808a;
        font-size: 14px;
        line-height: 1.6;
    }

    /* Responsive */

   @@media (max-width: 768px) {

        .hero-section {
            padding: 28px 24px;
        }

        .hero-section h1 {
            font-size: 28px;
        }

        .notifications-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .notification-item {
            padding: 20px;
        }

        .notification-action {
            display: none;
        }
    }

</style>